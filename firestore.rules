rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read access to all portfolio documents & collections
    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /projects/{projectDoc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{productDoc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
